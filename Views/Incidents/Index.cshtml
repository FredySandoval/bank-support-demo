@model List<Incident>
@{ ViewData["Title"] = "Incidents"; }
<h1>Incidents</h1>
<p>Dates are UTC.</p>
@if (Model.Count == 0)
{
    <p>No incidents recorded.</p>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <thead><tr><th>ID</th><th>Date</th><th>Type</th><th>Message</th><th>Transfer ID</th></tr></thead>
        <tbody>
        @foreach (var incident in Model)
        {
            <tr>
                <td>@incident.Id</td><td>@incident.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@incident.Type</td><td>@incident.Message</td><td>@(incident.TransferId?.ToString() ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
